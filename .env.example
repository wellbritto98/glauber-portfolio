# Copie este arquivo para .env.local e preencha com os dados do SEU projeto Firebase.
# Onde encontrar: Firebase Console > Configurações do projeto (engrenagem) >
# Seus apps > app web > Configuração do SDK.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Defina como "1" para apontar o app aos emuladores locais.
VITE_USE_EMULATORS=

# Usadas apenas pelo script de seed (npm run seed).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
